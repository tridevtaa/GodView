# Built files have a content hash in their name and never change: cache for
# a year. The page itself is checked each time so new releases show at once.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=604800

/*.svg
  Cache-Control: public, max-age=604800

/sw.js
  Cache-Control: no-cache

# The assistant's clips and still: names stay the same when a clip is
# redone, so a day only. Its clips.json is checked each time, so new clips
# show at once.
/concierge/*.mp4
  Cache-Control: public, max-age=86400

/concierge/*.jpg
  Cache-Control: public, max-age=86400

# The landing page's recorded answers: voice.json says which text each file
# holds and is checked each time; the files themselves keep a day.
/landing/voice/voice.json
  Cache-Control: no-cache

/landing/voice/*.mp3
  Cache-Control: public, max-age=86400

# Pictures on the landing page, and the frames of its scroll scene: a day.
/landing/*.jpg
  Cache-Control: public, max-age=86400

/landing/laptop/*
  Cache-Control: public, max-age=86400
