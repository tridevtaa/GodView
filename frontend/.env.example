# Supabase project (Project Settings → API). The publishable key is meant to be
# public; Row Level Security protects the data. Never put the secret key here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Google Maps (place search and pins). A browser key, locked in Google Cloud to
# GodView's web addresses and to Maps JavaScript API + Places API (New).
VITE_GOOGLE_MAPS_KEY=
# Map ID (Google Maps Platform > Map management), needed for the pins.
VITE_GOOGLE_MAP_ID=

# Parent login buttons on the landing page and app welcome. Leave off until
# WhatsApp codes work; /parent still opens it for testing.
VITE_PARENT_LOGIN=
